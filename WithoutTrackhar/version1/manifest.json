{
  "manifest_version": 3,
  "name": "Privacy Tracker Report",
  "version": "1.0",
  "description": "Detects third-party trackers on websites",
  "permissions": [
    "webRequest",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Privacy Report"
  }
}