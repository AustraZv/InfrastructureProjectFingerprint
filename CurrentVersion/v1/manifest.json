{
  "manifest_version": 2,
  "name": "Privacy Tracker Scanner",
  "version": "1.2.0",
  "description": "Detects and analyzes third-party trackers using HAR logging and TrackHAR analysis.",
  "browser_specific_settings": {
  "gecko": {
    "id": "webtrackertracker@cool",
    "data_collection_permissions": {
      "required": [
        "none"
      ]
    },
    "strict_min_version": "58.0"
  }
},
  "permissions": [
    "webRequest",
    "<all_urls>",
    "storage",
    "tabs",
    "downloads"
  ],
  "web_accessible_resources": [
    "tracker_rules.json"
  ],
  "content_security_policy": "script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; object-src 'self';",
  "background": {
    "scripts": [
      "trackerMatcher.js",
      "harBuilder.js",
      "trackhar.bundle.js",
      "trackhar_integration.js",
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_popup": "popup.html"
  }
  
}